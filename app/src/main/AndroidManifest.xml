<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JenuGumpu">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.JenuGumpu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HarvestActivity"
            android:exported="false"
            android:label="@string/harvest_log" />

        <activity
            android:name=".GradingActivity"
            android:exported="false"
            android:label="@string/grading_tool" />

        <activity
            android:name=".PriceActivity"
            android:exported="false"
            android:label="@string/price_monitor" />

        <activity
            android:name=".BatchActivity"
            android:exported="false"
            android:label="@string/batch_tracker" />

        <activity
            android:name=".ProfitActivity"
            android:exported="false"
            android:label="@string/profit_calculator" />
    </application>

</manifest>